---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { fetchYoutubeItems, youtubeChannelUrl } from '../lib/youtube';

const youtubeItems = await fetchYoutubeItems();
const hasApiItems = youtubeItems.some((item) => item.videoId);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`YouTube | ${SITE_TITLE}`} description="Videos y shorts de Musically Ivan." />
	</head>
	<body>
		<Header />
		<main class="page-shell">
			<section class="page-hero">
				<p class="eyebrow">YouTube</p>
				<h1>Videos y shorts</h1>
				<p>{hasApiItems ? 'Contenido cargado automaticamente desde YouTube Data API.' : 'Conecta la API para cargar los ultimos videos del canal.'}</p>
				<a href={youtubeChannelUrl} target="_blank" rel="noreferrer">Abrir canal</a>
			</section>
			<section class="video-grid" aria-label="Videos de YouTube">
				{youtubeItems.map((item, index) => (
					<a class="youtube-card" href={item.url} target="_blank" rel="noreferrer">
						{item.videoId ? (
							<div class="video-frame">
								<iframe
									src={`https://www.youtube-nocookie.com/embed/${item.videoId}`}
									title={item.title}
									loading="lazy"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
								></iframe>
							</div>
						) : (
							<div class="video-frame fallback" aria-hidden="true">
								<span>{item.type}</span>
								<strong>{index + 1}</strong>
							</div>
						)}
						<p>{item.type}</p>
						<h2>{item.title}</h2>
						{item.publishedAt && <time datetime={item.publishedAt}>{new Date(item.publishedAt).toLocaleDateString('es-ES')}</time>}
					</a>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-shell {
		width: min(1180px, calc(100% - 32px));
		margin: 0 auto;
		padding: 40px 0 70px;
	}

	.page-hero {
		border: 1px solid rgba(24, 24, 27, 0.1);
		padding: 32px;
		background: #ffffff;
	}

	.eyebrow,
	.youtube-card p {
		margin: 0 0 10px;
		color: #c92754;
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(3rem, 8vw, 6rem);
		line-height: 0.95;
	}

	.page-hero > p {
		max-width: 720px;
		margin: 18px 0 24px;
		color: #52525b;
	}

	.page-hero a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 16px;
		background: #18181b;
		color: #ffffff;
		font-weight: 700;
		text-decoration: none;
	}

	.video-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
		margin-top: 24px;
	}

	.youtube-card {
		display: grid;
		gap: 12px;
		border: 1px solid rgba(24, 24, 27, 0.1);
		padding: 14px;
		background: #ffffff;
		color: #18181b;
		text-decoration: none;
	}

	.video-frame {
		position: relative;
		overflow: hidden;
		aspect-ratio: 9 / 16;
		background: #18181b;
	}

	.video-frame iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.video-frame.fallback {
		display: grid;
		place-items: center;
		color: #ffffff;
	}

	.youtube-card h2 {
		margin: 0;
		font-size: 1rem;
		line-height: 1.3;
	}

	time {
		color: #71717a;
		font-size: 0.86rem;
		font-weight: 700;
	}

	@media (max-width: 960px) {
		.video-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.video-grid {
			grid-template-columns: 1fr;
		}

		.video-frame {
			aspect-ratio: 16 / 9;
		}
	}
</style>
