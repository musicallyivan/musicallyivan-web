---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { fetchYoutubeChannel } from '../lib/youtube';

const channel = await fetchYoutubeChannel();
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="site-shell">
			<section class="hero" aria-labelledby="page-title" style={channel.bannerUrl ? `--youtube-banner: url('${channel.bannerUrl}')` : undefined}>
				<div class="hero-copy">
					<div class="banner-strip" aria-label="Banner">
						<span>Banner oficial</span>
						<strong>Imagen tomada del canal de YouTube</strong>
					</div>
					<p class="eyebrow">Archivo musical y viral</p>
					<h1 id="page-title">Musically Ivan</h1>
					<p>
						Recopilaciones, tendencias y momentos de TikTok organizados en una web rapida, editable y lista
						para crecer con Astro.
					</p>
				</div>
				<div class="hero-panel" aria-label="Entrada destacada">
					<span>Destacado</span>
					<h2>TikTok Despecha</h2>
					<p>Entrada principal tomada como referencia del blog original.</p>
					<a href="/archivo">Leer entradas</a>
				</div>
			</section>

			<section class="site-stats" aria-label="Estadisticas de la web">
				<div class="stat-card">
					<span id="visit-count">0</span>
					<p>Visitas de la web</p>
				</div>
				<div class="stat-card">
					<span id="follower-count">0</span>
					<p>Followers de la web</p>
				</div>
				<div class="stats-action">
					<button type="button" id="follow-site">Seguir web</button>
					<a href="/comunidad">Ir a comunidad</a>
				</div>
			</section>
		</main>
		<Footer />
		<script>
			const visitCount = document.querySelector('#visit-count');
			const followerCount = document.querySelector('#follower-count');
			const followSite = document.querySelector('#follow-site');

			const formatNumber = (value) => new Intl.NumberFormat('es-ES').format(value);
			const baseVisits = 12480;
			const baseFollowers = 842;
			const visits = Number(localStorage.getItem('musicallyivan:visits') ?? '0') + 1;
			localStorage.setItem('musicallyivan:visits', String(visits));
			if (visitCount) visitCount.textContent = formatNumber(baseVisits + visits);

			const updateFollowers = () => {
				const followed = localStorage.getItem('musicallyivan:followed') === 'true';
				const localFollowers = Number(localStorage.getItem('musicallyivan:followers') ?? '0');
				if (followerCount) followerCount.textContent = formatNumber(baseFollowers + localFollowers);
				if (followSite) followSite.textContent = followed ? 'Siguiendo' : 'Seguir web';
			};

			followSite?.addEventListener('click', () => {
				if (localStorage.getItem('musicallyivan:followed') === 'true') return;
				const localFollowers = Number(localStorage.getItem('musicallyivan:followers') ?? '0') + 1;
				localStorage.setItem('musicallyivan:followers', String(localFollowers));
				localStorage.setItem('musicallyivan:followed', 'true');
				updateFollowers();
			});

			updateFollowers();
		</script>
	</body>
</html>

<style>
	.site-shell {
		width: min(1180px, calc(100% - 32px));
		margin: 0 auto;
		padding: 32px 0 64px;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
		gap: 24px;
		align-items: center;
		min-height: 470px;
		border: 1px solid rgba(24, 24, 27, 0.1);
		padding: 28px 44px 44px;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.72)),
			var(
					--youtube-banner,
					url('https://images.unsplash.com/photo-1516280440614-37939bbacd81?auto=format&fit=crop&w=1600&q=80')
				)
				center/cover;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 398px;
		max-width: 670px;
	}

	.banner-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 18px;
		align-self: flex-start;
		margin-bottom: 32px;
		padding: 12px 16px;
		background: #ffffff;
		box-shadow: 0 18px 38px rgba(24, 24, 27, 0.08);
		font-size: 0.9rem;
	}

	.banner-strip span,
	.eyebrow {
		color: #c92754;
		font-weight: 700;
	}

	.banner-strip strong {
		color: #18181b;
	}

	.eyebrow {
		margin: 0 0 8px;
		font-size: 0.88rem;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h1 {
		max-width: 640px;
		margin: 0;
		color: #111118;
		font-size: clamp(4rem, 10vw, 7rem);
		line-height: 0.98;
	}

	.hero-copy > p:not(.eyebrow) {
		max-width: 610px;
		margin: 28px 0 0;
		color: #3f3f46;
		font-size: 1.05rem;
		line-height: 1.65;
	}

	.hero-panel {
		padding: 38px 28px;
		background: #18181b;
		color: #ffffff;
	}

	.hero-panel span {
		color: #ffb703;
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.hero-panel h2 {
		margin: 18px 0 14px;
		color: #ffffff;
		font-size: 2rem;
	}

	.hero-panel p {
		margin: 0 0 26px;
		color: #f4f4f5;
		font-size: 0.98rem;
		line-height: 1.65;
	}

	.hero-panel a {
		display: inline-flex;
		align-items: center;
		min-height: 42px;
		padding: 0 16px;
		background: #ffffff;
		color: #18181b;
		font-weight: 700;
		text-decoration: none;
	}

	.site-stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		margin-top: 32px;
	}

	.stat-card,
	.stats-action {
		border: 1px solid rgba(24, 24, 27, 0.1);
		padding: 24px 22px;
		background: #ffffff;
	}

	.stat-card span {
		color: #c92754;
		font-size: 2rem;
		font-weight: 700;
		line-height: 1;
	}

	.stat-card p {
		margin: 8px 0 0;
		color: #52525b;
		font-size: 0.94rem;
		font-weight: 700;
	}

	.stats-action {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		align-items: center;
	}

	.stats-action button,
	.stats-action a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		border: 0;
		padding: 0 14px;
		background: #18181b;
		color: #ffffff;
		font: inherit;
		font-weight: 700;
		text-decoration: none;
		cursor: pointer;
	}

	.stats-action a {
		background: #c92754;
	}

	@media (max-width: 880px) {
		.hero,
		.site-stats {
			grid-template-columns: 1fr;
		}

		.hero {
			padding: 24px;
		}

		.hero-copy {
			min-height: 0;
		}
	}

	@media (max-width: 560px) {
		.site-shell {
			width: min(100% - 20px, 1180px);
			padding-top: 16px;
		}

		.hero {
			min-height: 0;
		}

		h1 {
			font-size: 4rem;
		}
	}
</style>
